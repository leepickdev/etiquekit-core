{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowJs": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "lib": ["ES2022"]
  },
  "include": [
    "packages/**/*.ts",
    "examples/**/*.ts",
    "contracts/**/*.ts"
  ]
}
