{
  "name": "etiquekit-core-repo",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "Public source home for @etiquekit/core.",
  "workspaces": [
    "packages/core"
  ],
  "scripts": {
    "ci": "bun run gate:v2 && bun run typecheck && bun test",
    "gate:v2": "bun scripts/gate-v2-check.mjs",
    "test": "bun test contracts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/bun": "^1.2.17",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "@etiquekit/core": "workspace:*"
  },
  "homepage": "https://etiquekit.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leepickdev/etiquekit-core.git"
  },
  "bugs": {
    "url": "https://github.com/leepickdev/etiquekit-core/issues"
  }
}
